# 个股买卖点监测系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 运行环境 ──
APP_ENV=dev
# dev 模式下跳过飞书签名校验 + 可选 JWT 认证
# 生产环境改为 prod，强制 JWT 登录

# ── 登录认证 ──
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin123
# 生产环境务必修改密码！

# ── 数据库 ──
# 开发环境默认 SQLite，无需修改
DATABASE_URL=sqlite+aiosqlite:///./data/stock_monitor.db
DATABASE_URL_SYNC=sqlite:///./data/stock_monitor.db

# ── 飞书 Bot（开发环境可不填，本地用 feishu_test.html 测试）──
# 从飞书开放平台 → 应用 → 凭证与基础信息 获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书事件订阅 → 请求地址配置时的 Verification Token
FEISHU_VERIFY_TOKEN=xxxxxxxxxxxxxxxx

# ── DeepSeek AI（可选，不填则使用快捷菜单模式）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
