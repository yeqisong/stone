# 个股买卖点监测系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 运行环境 ──
APP_ENV=dev
# dev 模式下跳过飞书签名校验 + 可选 JWT 认证
# 生产环境改为 prod，强制 JWT 登录
# 生产环境必须设置为 16 位以上的随机字符串
APP_SECRET_KEY=kdao-dev-secret-key-change-in-production

# ── 登录认证 ──
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin123
# 生产环境务必修改密码！

# ── 数据库（PostgreSQL 15）──
DATABASE_URL=postgresql+asyncpg://stock:stock123@localhost:5432/stock_monitor
DATABASE_URL_SYNC=postgresql+psycopg2://stock:stock123@localhost:5432/stock_monitor

# ── TuShare（主数据源，必填）──
# 从 https://tushare.pro 注册后获取；配额按 50 次/分、8000 次/天预算
TUSHARE_TOKEN=your_tushare_token

# ── 飞书 Bot（开发环境可不填，本地用 feishu_test.html 测试）──
# 从飞书开放平台 → 应用 → 凭证与基础信息 获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书事件订阅 → 请求地址配置时的 Verification Token
FEISHU_VERIFY_TOKEN=xxxxxxxxxxxxxxxx

# ── DeepSeek AI（可选，不填则使用快捷菜单模式）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
