# 个股买卖点监测系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 运行环境 ──
APP_ENV=dev
# 必须配置：至少 32 字符的随机字符串，缺失/公开默认值/过短会拒绝启动
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Agent 工作区文件签名独立密钥（留空则从 APP_SECRET_KEY 域分离派生）
AGENT_FILE_SECRET=
# 特征是否使用后复权 OHLCV：完成 scripts/rebuild_features_adjusted.py 全量重建并重训后置 true
FEATURE_PRICE_ADJUST=false

# ── 登录认证 ──
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin123
# 生产环境务必修改密码！

# ── 数据库（PostgreSQL 15）──
DATABASE_URL=postgresql+asyncpg://stock:stock123@localhost:5432/stock_monitor
DATABASE_URL_SYNC=postgresql+psycopg2://stock:stock123@localhost:5432/stock_monitor

# ── TuShare（主数据源，必填）──
# 从 https://tushare.pro 注册后获取；配额按 50 次/分、8000 次/天预算
TUSHARE_TOKEN=your_tushare_token

# ── 飞书 Bot（开发环境可不填，本地用 feishu_test.html 测试）──
# 从飞书开放平台 → 应用 → 凭证与基础信息 获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书事件订阅 → 请求地址配置时的 Verification Token
FEISHU_VERIFY_TOKEN=xxxxxxxxxxxxxxxx

# ── DeepSeek AI（可选，不填则使用快捷菜单模式）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
